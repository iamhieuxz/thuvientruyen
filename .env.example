# Mẫu cấu hình cho translate/dich.py. Sao chép thành .env rồi điền key.
#   copy .env.example .env
# KHÔNG commit file .env thật.

# ── Backend: "gemini" hoặc "openai" ──
BACKEND=gemini

# ── Google AI Studio (Gemini) ──
# Key miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Một model, hoặc danh sách phân tách bằng dấu phẩy để tự chuyển khi hết hạn mức.
# Bỏ trống thì dùng MODEL_FALLBACK trong translate/dich.py.
GEMINI_MODEL=
GEMINI_MODELS=
GEMINI_MAX_TOKENS=65536
GEMINI_RETRY=2

# ── Backend tương thích OpenAI (OpenAI, DeepSeek, vpsnodelab...) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MAX_TOKENS=16384
OPENAI_RETRY=3

# ── Vận hành ──
# Truyện mặc định khi không truyền --book (xem BOOKS trong translate/dich.py).
BOOK=baojian
# Số chương dịch song song.
WORKERS=4
