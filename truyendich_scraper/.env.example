# Cấu hình TruyenDich Scraper

# ======================
# HTTP
# ======================
REQUEST_TIMEOUT=30
MAX_CONCURRENT=3              # số request đồng thời
REQUESTS_PER_SECOND=0.7       # giới hạn tốc độ
MAX_RETRIES=4
BACKOFF_FACTOR=1.5            # exponential backoff
PROXY_URL=                    # để trống nếu không dùng

# ======================
# User-Agents (rotate)
# ======================
# false -> dùng pool UA tĩnh (nhanh, không cần mạng) - KHUYẾN NGHỊ
# true  -> dùng fake_useragent (cần tải dataset, chậm hơn)
ENABLE_UA_ROTATION=false

# ======================
# Storage
# ======================
RAW_DIR=data/raw
NOVEL_DIR=data/novels

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# ======================
# Behavior
# ======================
RESUME_FROM_CACHE=true
SAVE_RAW_HTML=false            # lưu HTML thô (tốn dung lượng)
DEFAULT_DELAY_BEFORE_END=true  # gửi delay đến chương cuối
